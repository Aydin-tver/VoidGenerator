{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["encounter_id", "opponent_archetype", "strength", "outcomes", "skill_alternatives"],
  "properties": {
    "$schema": {"type": "string"},
    "encounter_id": {"type": "string", "pattern": "^enc_[a-z0-9_]+"},
    "opponent_archetype": {"type": "string", "enum": ["trader", "mechanic", "informant", "guard", "smuggler", "medic", "official", "drifter"]},
    "strength": {"type": "string", "enum": ["trivial", "medium", "deadly"]},
    "outcomes": {
      "type": "object",
      "required": ["win", "wounded", "retreat"],
      "properties": {
        "win": {"type": "object"},
        "wounded": {"type": "object"},
        "retreat": {"type": "object"}
      }
    },
    "skill_alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["skill", "level", "description"],
        "properties": {
          "skill": {"type": "string", "enum": ["engineering", "hacking", "persuasion", "combat", "navigation"]},
          "level": {"type": "integer", "minimum": 1, "maximum": 5},
          "specialization": {"type": "string"},
          "description": {"type": "string", "maxLength": 200}
        }
      }
    }
  }
}
