{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wanderers Dialogue v0.9",
  "type": "object",
  "required": [
    "id",
    "speaker",
    "station",
    "type",
    "nodes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^dialogue\\.[a-z0-9_.]+$"
    },
    "speaker": {
      "type": "string",
      "pattern": "^character\\.[a-z0-9_.]+$"
    },
    "station": {
      "type": "string",
      "pattern": "^station\\.[a-z0-9_.]+$"
    },
    "type": {
      "enum": [
        "ambient",
        "informational",
        "character",
        "investigative",
        "negotiation",
        "conflict",
        "revelation",
        "resolution"
      ]
    },
    "conditions": {
      "type": "array"
    },
    "nodes": {
      "type": "array"
    },
    "effects": {
      "type": "array"
    }
  },
  "additionalProperties": true
}