{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wanderers Mission v0.9",
  "type": "object",
  "required": [
    "id",
    "version",
    "type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^mission\\.[a-z0-9_.]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "normal",
        "character",
        "faction",
        "investigative",
        "world_event",
        "main_story"
      ]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "start": {
      "type": "object"
    },
    "success_effects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}