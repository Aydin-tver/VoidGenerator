{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Void Event Engine Narrative Authoring Contract",
  "type": "object",
  "required": ["schemaVersion", "contractVersion", "contentId", "storyId", "namespace", "version", "owner", "source", "stableIds", "localization", "dependencies", "narrative"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractVersion": {"const": 1},
    "contentId": {"type": "string", "minLength": 1},
    "storyId": {"type": "string", "minLength": 1},
    "namespace": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "version": {"type": "integer", "minimum": 1},
    "owner": {"type": "object", "required": ["agentId"], "properties": {"agentId": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "source": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "stableIds": {"type": "object", "required": ["nodePrefix", "choicePrefix"], "properties": {"nodePrefix": {"type": "string", "minLength": 1}, "choicePrefix": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "localization": {"type": "object", "required": ["keys"], "properties": {"keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false},
    "dependencies": {"type": "object", "required": ["events", "consequences", "narratives"], "properties": {"events": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "consequences": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "narratives": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false},
    "narrative": {"type": "object", "required": ["id", "version", "startNodeId", "nodes"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "startNodeId": {"type": "string", "minLength": 1}, "nodes": {"type": "array", "minItems": 1}}, "additionalProperties": true}
  },
  "additionalProperties": false
}
