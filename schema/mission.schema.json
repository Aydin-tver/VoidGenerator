{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "void-event-engine/mission.schema.json",
  "title": "Wanderers Mission Definition",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "titleKey",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^mission\\.[a-z0-9_.-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "titleKey": {
      "type": "string"
    },
    "descriptionKey": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayKey",
          "event"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "displayKey": {
            "type": "string"
          },
          "locationKey": {
            "type": "string"
          },
          "clueKey": {
            "type": "string"
          },
          "sourceKey": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "optional": {
            "type": "boolean"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "event": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "path": {
                    "type": "string"
                  },
                  "equals": {},
                  "contains": {},
                  "greaterThan": {
                    "type": "number"
                  },
                  "lessThan": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "op",
                  "conditions"
                ],
                "properties": {
                  "op": {
                    "const": "all"
                  },
                  "conditions": {
                    "type": "array",
                    "minItems": 1
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": [
                  "op",
                  "conditions"
                ],
                "properties": {
                  "op": {
                    "const": "any"
                  },
                  "conditions": {
                    "type": "array",
                    "minItems": 1
                  }
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": [
                  "op",
                  "condition"
                ],
                "properties": {
                  "op": {
                    "const": "not"
                  },
                  "condition": {
                    "type": "object"
                  }
                },
                "additionalProperties": true
              }
            ]
          },
          "nextStepId": {
            "type": "string"
          },
          "outcomeId": {
            "type": "string"
          },
          "failOutcomeId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "terminal": {
            "type": "boolean"
          },
          "nextStepId": {
            "type": "string"
          },
          "nextMissionId": {
            "type": "string"
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "payload": {
                  "type": "object"
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "startStepId": {
      "type": "string"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
